generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                                      Int       @id @default(autoincrement())
  name                                    String    @db.VarChar()
  lastname                                String    @db.VarChar()
  email                                   String    @unique() @db.VarChar()
  password                                String    @db.VarChar()
  active                                  Boolean?  @default(true)
  role                                    RoleEnum  @map("role") @default(USER)
  createdAt                               DateTime  @default(now()) @map("created_at")
  updatedAt                               DateTime  @updatedAt @map("updated_at")

  profile Profile?
  provisionalPassword ProvisionalPassword[]
  address Address[]
  @@map("users")
}

model ProvisionalPassword {
  id                                      Int       @id @default(autoincrement())
  userId                                  Int       @map("user_id")
  provisionalPassword                     String?   @map("provisional_password")
  active                                  Boolean?  @default(false) @map("active")
  expiresIn                               DateTime? @map("expires_in")
  createdAt                               DateTime  @default(now()) @map("created_at")
  updatedAt                               DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])
  @@map("provisional_password")
}

model Profile {
  id               Int       @id @default(autoincrement())
  userId           Int       @unique @map("user_id")
  birthDay         DateTime? @map("birth_day")
  phone            String?   @db.VarChar()
  gender           String?   @db.VarChar()
  document         String?   @db.VarChar()
  documentType     String?   @db.VarChar() @map("document_type")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])
  @@map("profiles")
}

model Address {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  neighborhood String   @db.VarChar()
  street       String?  @db.VarChar()
  number       String?  @db.VarChar()
  city         String   @db.VarChar()
  country      String   @db.VarChar()
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])
  @@map("addresses")
}

model BlackListTokens {
  token           String   @id @db.VarChar()
  revokedByUserId Int      @map("revoked_by_user_id")
  args            String   @db.VarChar(200)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("black-list-tokens")
}

enum RoleEnum {
  USER
  ADMIN
}
